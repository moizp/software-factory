{
  "version": 1,
  "default": { "auto_merge": true, "approvals": 1, "require": ["ci", "reviewer_verdict"] },
  "protected_paths": [
    ".factory/**",
    ".github/**",
    ".claude/**",
    "scripts/**",
    "templates/**",
    "package.json",
    "package-lock.json",
    "CONTRIBUTING.md",
    "MISSION.md",
    "CHARACTER.md",
    "LOOKFEEL.md"
  ],
  "force_manual_labels": ["needs-human"],
  "rules": [
    {
      "name": "docs only",
      "match": { "paths_only": ["**/*.md", "docs/**"], "max_files": 20 },
      "auto_merge": true
    }
  ]
}

{
  "$id": "https://software-factory/contracts/envelope.schema.json",
  "title": "Agent response envelope",
  "type": "object",
  "required": ["phase", "valid"],
  "properties": {
    "phase": { "type": "string", "minLength": 1 },
    "valid": { "type": "boolean" },
    "error": { "type": "string" },
    "blockers": { "type": "array" },
    "next_inputs": { "type": "object" },
    "output": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "content": { "type": "object" }
        }
      }
    }
  },
  "if": { "properties": { "valid": { "const": false } }, "required": ["valid"] },
  "then": {
    "anyOf": [
      { "required": ["error"], "properties": { "error": { "minLength": 1, "pattern": "\\S" } } },
      { "required": ["blockers"], "properties": { "blockers": { "minItems": 1 } } }
    ]
  }
}

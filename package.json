{
  "name": "software-factory",
  "version": "1.0.0",
  "description": "Multi-agent software factory orchestration engine",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node",
    "validate-setup": "bash scripts/validate-setup.sh",
    "factory:start": "npm run validate-setup && ts-node .factory/cli.ts start",
    "factory:status": "ts-node .factory/cli.ts status",
    "factory:list": "ts-node .factory/cli.ts list",
    "factory:watch": "ts-node .factory/cli.ts watch",
    "factory:retry": "ts-node .factory/cli.ts retry",
    "factory:replay": "ts-node .factory/cli.ts replay",
    "factory:answer": "ts-node .factory/cli.ts answer",
    "orchestrator:run": "ts-node .factory/run-workflow.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "orchestrator:test": "ts-node .factory/test.ts",
    "policy:check": "ts-node .factory/policy-cli.ts",
    "gate:check": "ts-node .factory/gate/cli.ts",
    "gate:commit": "ts-node .factory/gate/commit-cli.ts",
    "report:prompts": "ts-node .factory/report-cli.ts prompts",
    "report:usage": "ts-node .factory/report-cli.ts usage",
    "mission:check": "ts-node .factory/mission-cli.ts",
    "lookfeel": "ts-node .factory/lookfeel-cli.ts",
    "lookfeel:check": "ts-node .factory/lookfeel-cli.ts check"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}

# Copy to .env (never commit .env). Every variable the app reads is listed here with a safe local value,
# so `npm run doctor` can tell you what is missing.
NODE_ENV=development
PORT=5173
LOG_LEVEL=debug
# 1: payments, email and other third parties are replaced by local fakes, so nothing real is called or charged
MOCK_EXTERNALS=1
DATABASE_URL=postgresql://app:app@localhost:5432/app

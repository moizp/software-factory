#!/usr/bin/env bash
# Writer-tier guard: agents push feature branches only. Merging is the Verification Tier's job.
# Blocks pushes to main/master/release/*/www-*, branch deletions and non-fast-forward (force) pushes.
# This is a soft layer. The hard layer is repository protection and a token that cannot push to main.
set -euo pipefail
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"

  case "$branch" in
    main|master|release/*|www-*)
      echo "pre-push: refusing to push to '$branch'. Push a feature branch and open a PR." >&2
      exit 1 ;;
  esac

  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete remote ref '$remote_ref'." >&2
    exit 1
  fi

  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing non-fast-forward push to '$branch' (force push)." >&2
    exit 1
  fi
done
exit 0

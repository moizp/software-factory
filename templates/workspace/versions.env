# Single source of truth for every writer workspace (Buddy sandbox, Oracle VM, a laptop).
# Change a version here, commit, re-run bootstrap.sh everywhere; doctor.sh reports drift.
NODE_VERSION=24.22.0
CLAUDE_CODE_VERSION=2.1.292
TMUX_MIN_MAJOR=3
MIN_FREE_DISK_GB=5
# Actions runner for the Oracle lane (docs/CLOUD-RUNNERS.md). Leave blank to resolve the latest release at install
# time; the installer prints the version it used. Record it here once it works, so every machine matches.
RUNNER_VERSION=

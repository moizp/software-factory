{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push*--delete*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(gh pr merge*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/factory/**)",
      "Read(~/.ssh/**)"
    ]
  }
}

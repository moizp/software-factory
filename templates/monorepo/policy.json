{
  "version": 1,
  "default": { "auto_merge": true, "approvals": 1, "require": ["ci", "reviewer_verdict"] },
  "protected_paths": [
    ".factory/**",
    ".github/**",
    ".claude/**",
    "contracts/**",
    "libs/**",
    "services/*/migrations/**",
    "services/*/scripts/deploy.sh",
    "package.json",
    "package-lock.json"
  ],
  "force_manual_labels": ["needs-human"],
  "rules": [
    {
      "name": "docs only",
      "match": { "paths_only": ["**/*.md", "docs/**"], "max_files": 20 },
      "auto_merge": true
    },
    {
      "name": "auth always human",
      "match": { "paths_any": ["services/auth/**"] },
      "auto_merge": false,
      "approvals": 1
    }
  ]
}

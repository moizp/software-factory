#!/bin/bash

# Credentials Template
# Copy to: scripts/credentials.sh (which is gitignored)
# Fill in your actual API keys and secrets
# Then run: source scripts/credentials.sh

# ============================================================================
# IMPORTANT: Never commit this file with real values!
# Add scripts/credentials.sh to .gitignore (already done)
# ============================================================================

# GitHub
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, workflow, admin:repo_hook
export GITHUB_TOKEN="ghp_YOUR_GITHUB_TOKEN_HERE"

# PostgreSQL Database
# Format: postgres://username:password@host:port/database
# Local dev example: postgres://postgres:password@localhost:5432/mydb
export DB_PASSWORD="postgres://user:password@localhost:5432/mydb"

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
# Use test key for development: sk_test_...
export STRIPE_MCP_KEY="sk_test_YOUR_STRIPE_TEST_KEY_HERE"

# Slack (optional)
# Get from: https://api.slack.com/apps
# Bot token for your app
export SLACK_BOT_TOKEN="xoxb-YOUR_SLACK_BOT_TOKEN_HERE"

# Supabase (optional)
# Get from: https://supabase.com/dashboard
# Project API key
export SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# Optional: Environment-specific configs
# ============================================================================

# Development environment
export NODE_ENV="development"
export API_URL="http://localhost:3000"

# Logging level
export LOG_LEVEL="debug"

# JWT Secret (for development only - use secure random in production)
export JWT_SECRET="dev-jwt-secret-change-in-production"

# ============================================================================
# How to Use
# ============================================================================
# 
# 1. Copy this file:
#    cp scripts/credentials.sh.template scripts/credentials.sh
#
# 2. Edit scripts/credentials.sh and fill in real values:
#    export GITHUB_TOKEN="ghp_..."
#    export STRIPE_MCP_KEY="sk_test_..."
#    etc.
#
# 3. Source the credentials in your shell:
#    source scripts/credentials.sh
#
# 4. Run the MCP setup:
#    ./scripts/setup-mcp.sh
#
# 5. Start Claude Code:
#    claude
#
# 6. Execute the factory:
#    claude "Execute complete factory workflow"
#
# ============================================================================

# Safety check - remind user this is a template
if [ "${BASH_SOURCE[0]}" == "${0}" ]; then
    echo "❌ This is a template file. Please:"
    echo "   1. Copy: cp scripts/credentials.sh.template scripts/credentials.sh"
    echo "   2. Edit: Edit scripts/credentials.sh with real values"
    echo "   3. Source: source scripts/credentials.sh"
    exit 1
fi
